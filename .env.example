# Settings for the lobby. Copy to .env only if you want them in a file: `scripts/run.sh` loads it.
# No secret belongs in this example. Keys are read from the environment, or from
# ~/Secrets/Daytona/key and ~/Secrets/Nosana/key if those files exist.

# Where the lobby listens, and the address people's browsers use.
DUET_BIND=127.0.0.1:8787
DUET_PUBLIC_URL=http://127.0.0.1:8787

# Clocks, in seconds. For a stage demo: DUET_SESSION_SECS=45
DUET_SESSION_SECS=900
DUET_LONG_SESSION_SECS=2700
DUET_REMATCH_AFTER_SECS=86400

# auto: Daytona sandboxes when a key is present, otherwise rooms inside the lobby.
DUET_ROOMS=auto

# Daytona. DAYTONA_API_KEY is not set here on purpose.
# Which API: auto (the new SDK 2.0 API when it knows the key, else the original), v2 or v0.
DUET_DAYTONA_API=auto
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_V2_API_URL=https://api.daytona.com
# DAYTONA_TARGET=               # a region
# DUET_DAYTONA_SNAPSHOT=        # a snapshot (new API: an image) that already holds /usr/local/bin/duet-room

# Rooms built ahead in Daytona, a batch at the same time, and how long one may wait unused.
DUET_WARM_ROOMS=3
DUET_WARM_MAX_SECS=1200
# The admin page's key (/hood#key=...). Made up at each start and printed when not set.
# DUET_ADMIN_KEY=

# Nosana (OpenAI-compatible). NOSANA_API_KEY is not set here on purpose.
# If an address or model is handed out on the day, put it here.
NOSANA_LLM_URL=https://inference.nosana.com/v1
# NOSANA_LLM_MODEL=

# Which activities pairs may be given (default: all five).
# DUET_ACTIVITIES=wavelength,sketch,signal,thisorthat,story
